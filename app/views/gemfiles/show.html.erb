<% content_for :title, "Audit Tool - Report ##{@alpha_id}" %>
<% content_for :description, "Report ##{@alpha_id} - #{@vulnerabilities_count} Vulnerabilities found on your file" %>

<% content_for :script do %>
  <script>
    $('html, body').animate({
      scrollTop: $('#result').offset().top - 100
    }, 300);
  </script>
<% end %>

<%= render "shared/gemfile_upload_section", remote: false %>

<% if @vulnerabilities.present? %>
  <div id="result">
    <%= render "vulnerabilities_list" %>
  </div>
<% end %>
